      visualInput: 'Fragmented information',
      visualDocs: 'Documents',
      visualSheets: 'Data',
      visualEmails: 'Emails',
      visualProcess: 'CLARISENDA',
      visualProcessText: 'Structure · connect · verify',
      visualOutput: 'Operational evidence',
      visualTraceable: 'Traceable',
      visualVerifiable: 'Verifiable',

      problemLabel: 'The problem',
