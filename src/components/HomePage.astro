          class="group rounded-3xl border border-white/10 bg-white/[0.055] p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-[#79c0b7]/35 hover:bg-white/[0.08]"
        >

          <div class="flex items-start justify-between">

            <div
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#2d7d73]/35 text-[#8ed0c7]"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="7" height="6" rx="1.5" />
                <rect x="14" y="13" width="7" height="6" rx="1.5" />
                <path d="M10 8h4a3 3 0 0 1 3 3v2" />
                <path d="M14 16h-4a3 3 0 0 1-3-3v-2" />
              </svg>
            </div>

            <span class="h-2 w-2 rounded-full bg-[#f20a78]"></span>

          </div>

          <h3 class="mt-6 text-lg font-semibold text-white">
            {t.portable}
          </h3>

          <p class="mt-3 leading-7 text-white/70">
            {t.portableText}
          </p>

        </article>



        <!-- SEGURIDAD -->
        <article
          class="group relative overflow-hidden rounded-3xl border border-[#79c0b7]/25 bg-[#2d7d73]/20 p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:border-[#79c0b7]/45 hover:bg-[#2d7d73]/25"
        >

          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#2d7d73] via-[#79c0b7] to-[#f20a78]"></div>


          <div class="flex items-start justify-between">

            <div
              class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#2d7d73] text-white"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-6 w-6"
                aria-hidden="true"
              >
                <path d="M12 3l7 3v5c0 4.6-2.8 8-7 10-4.2-2-7-5.4-7-10V6z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </div>

            <span class="h-2 w-2 rounded-full bg-[#f20a78]"></span>

          </div>

          <h3 class="mt-6 text-lg font-semibold text-white">
            {t.securityDesign}
          </h3>

          <p class="mt-3 leading-7 text-white/65">
            {t.securityDesignText}
          </p>

        </article>


      </div>

    </div>

  </div>
</section>


<!-- CTA FINAL -->
<section class="relative overflow-hidden bg-[#eaf4f1]">

  <!-- Fondo decorativo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 top-10 h-72 w-72 rounded-full bg-[#2d7d73]/10 blur-3xl"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 bottom-0 h-80 w-80 rounded-full bg-[#123b45]/10 blur-3xl"
  ></div>


  <div class="relative mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8 lg:py-24">

    <div
      class="relative overflow-hidden rounded-[2rem] bg-[#102f38] px-7 py-12 text-white shadow-[0_30px_80px_rgba(18,59,69,0.16)] sm:px-10 lg:px-14 lg:py-14"
    >

      <!-- Destello superior -->
      <div
        aria-hidden="true"
        class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-[#2d7d73]/35 blur-3xl"
      ></div>


      <div class="relative grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center">


        <!-- MENSAJE -->
        <div class="max-w-3xl">

          <div class="flex items-center gap-3">

            <span class="h-2.5 w-2.5 rounded-full bg-[#f20a78]"></span>

            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#8ed0c7]">
              {t.finalClaim}
            </p>

          </div>


          <h2 class="mt-5 text-3xl font-semibold tracking-[-0.03em] text-white sm:text-4xl lg:text-[2.8rem] lg:leading-[1.08]">
            {t.finalTitle}
          </h2>


          <p class="mt-6 max-w-2xl text-lg leading-8 text-white/70">
            {t.finalIntro}
          </p>


          <!-- MICROCONFIANZA -->
          <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm text-white/55">

            <span class="flex items-center gap-2">
              <span class="text-[#8ed0c7]">✓</span>
              {t.noCommitment}
            </span>

            <span class="flex items-center gap-2">
              <span class="text-[#8ed0c7]">✓</span>
              {t.instantResult}
            </span>

            <span class="flex items-center gap-2">
              <span class="text-[#8ed0c7]">✓</span>
              {t.noRegistration}
            </span>

          </div>

        </div>


        <!-- CTA -->
        <div class="flex lg:justify-end">

          <a
            href="#project-check"
            class="group inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-white px-7 py-4 font-semibold text-[#123b45] shadow-[0_12px_30px_rgba(0,0,0,0.12)] transition duration-200 hover:-translate-y-0.5 hover:bg-[#eaf4f1] sm:w-auto"
          >
            {t.finalButton}

            <span
              aria-hidden="true"
              class="text-lg transition-transform duration-200 group-hover:translate-x-1"
            >
              →
            </span>

          </a>

        </div>

      </div>

    </div>

  </div>
</section>



<!-- FOOTER -->
<footer class="border-t border-slate-200 bg-white">

  <div class="mx-auto max-w-7xl px-6 lg:px-8">


    <!-- FOOTER PRINCIPAL -->
    <div class="grid gap-10 py-10 sm:grid-cols-2 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">


      <!-- MARCA -->
      <div>

        <a
          href={canonicalPath}
          class="inline-flex items-center"
          aria-label="CLARISENDA"
        >
          <img
            src="/logo-clarisenda.png"
            alt="CLARISENDA"
            width="360"
            height="120"
            class="h-11 w-auto object-contain"
          />
        </a>


        <p class="mt-4 max-w-md text-sm leading-6 text-slate-500">
          {t.footerClaim}
        </p>

      </div>


      <!-- CONTACTO -->
      <div class="sm:text-right">

        <a
          href="mailto:info@clarisenda.com"
          class="font-semibold text-[#123b45] transition hover:text-[#2d7d73]"
        >
          info@clarisenda.com
        </a>

        <p class="mt-2 text-sm text-slate-500">
          {t.location}
        </p>


        <!-- IDIOMAS -->
        <div class="mt-5 flex gap-2 sm:justify-end">

          <a
            href="/es/"
            class:list={[
              'rounded-lg px-3 py-2 text-xs font-semibold transition',
              isSpanish
                ? 'bg-[#123b45] text-white'
                : 'border border-slate-200 text-slate-500 hover:border-[#2d7d73] hover:text-[#2d7d73]'
            ]}
          >
            ES
          </a>

          <a
            href="/en/"
            class:list={[
              'rounded-lg px-3 py-2 text-xs font-semibold transition',
              !isSpanish
                ? 'bg-[#123b45] text-white'
                : 'border border-slate-200 text-slate-500 hover:border-[#2d7d73] hover:text-[#2d7d73]'
            ]}
          >
            EN
          </a>

        </div>

      </div>

    </div>


    <!-- PIE INFERIOR -->
    <div
      class="flex flex-col gap-3 border-t border-slate-200 py-6 text-xs text-slate-600 sm:flex-row sm:items-center sm:justify-between"
    >

      <p>
        © {currentYear} CLARISENDA
      </p>

      <div class="flex items-center gap-3">

        <span>
          {t.footerClaim}
        </span>

        <span
          aria-hidden="true"
          class="h-1.5 w-1.5 rounded-full bg-[#f20a78]"
        ></span>

      </div>

    </div>

  </div>

</footer>



    </main>

  </div>
</Layout>
