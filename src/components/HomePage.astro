---

<Layout
  lang={lang}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
>
  <div class="min-h-screen bg-[#f7f8f5] text-slate-900">

    <!-- CABECERA -->
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-[#f7f8f5]/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8">

    <a
      href={canonicalPath}
      class="flex items-center"
      aria-label="CLARISENDA"
    >
      <img
        src="/logo-clarisenda.png"
        alt="CLARISENDA"
        width="450"
        height="150"
        class="h-12 w-auto object-contain sm:h-14"
      />
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
      <a
        href="#como-funciona"
        class="transition hover:text-[#123b45]"
      >
        {isSpanish ? 'Cómo funciona' : 'How it works'}
      </a>

      <a
        href="#soluciones"
        class="transition hover:text-[#123b45]"
      >
        {isSpanish ? 'Soluciones' : 'Solutions'}
      </a>

      <a
        href="#seguridad"
        class="transition hover:text-[#123b45]"
      >
        {isSpanish ? 'Seguridad' : 'Security'}
      </a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">

      <a
        href={alternateLanguageUrl}
        aria-label={isSpanish ? 'English version' : 'Versión en español'}
        class="flex h-11 min-w-11 items-center justify-center rounded-xl border border-slate-300 px-3 text-sm font-semibold text-slate-600 transition hover:border-[#2d7d73] hover:text-[#2d7d73]"
      >
        {alternateLanguageLabel}
      </a>

      <a
        href="#project-check"
        class="rounded-xl bg-[#123b45] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#0d3038] sm:px-6"
      >
        <span class="sm:hidden">
          {isSpanish ? 'Calcular' : 'Calculate'}
        </span>

        <span class="hidden sm:inline">
          {isSpanish ? 'Calcula tu rentabilidad' : 'Calculate your ROI'}
        </span>
      </a>

    </div>

  </div>
</header>


<!-- HERO -->
<main>
<section class="relative overflow-hidden bg-[radial-gradient(circle_at_18%_22%,rgba(45,125,115,0.08),transparent_32%),radial-gradient(circle_at_88%_30%,rgba(18,59,69,0.05),transparent_30%)]">

  <!-- Fondo decorativo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -left-32 top-32 h-80 w-80 rounded-full bg-[#2d7d73]/5 blur-3xl"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-32 top-20 h-96 w-96 rounded-full bg-[#123b45]/5 blur-3xl"
  ></div>

  <div class="relative z-10 mx-auto grid max-w-7xl gap-10 px-5 pt-10 pb-16 sm:px-6 sm:pt-12 sm:pb-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 lg:px-8 lg:pt-16 lg:pb-24">

    <!-- Mensaje principal -->
    <div class="flex flex-col justify-start">

      <div class="mb-6">
        <span class="inline-flex items-center rounded-full border border-[#6aa69f]/30 bg-white/60 px-4 py-2 text-xs font-semibold text-[#27665f] shadow-sm backdrop-blur sm:text-sm">
          {t.eyebrow}
        </span>
      </div>

      <h1 class="max-w-3xl text-[2.75rem] font-semibold leading-[1.02] tracking-[-0.035em] text-[#102f38] sm:text-5xl lg:text-[4.25rem]">
        {t.heroStart}
        <span class="text-[#2d7d73]"> {t.heroHighlight}</span>
      </h1>

      <p class="mt-7 max-w-xl text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
        {t.heroText1}
      </p>

      <p class="mt-3 max-w-xl text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
        {t.heroText2}
      </p>

      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a
          href="#project-check"
          class="inline-flex items-center justify-center rounded-xl bg-[#123b45] px-7 py-4 text-center font-semibold text-white shadow-[0_10px_30px_rgba(18,59,69,0.16)] transition duration-200 hover:-translate-y-0.5 hover:bg-[#0d3038] hover:shadow-[0_14px_36px_rgba(18,59,69,0.22)]"
        >
          {t.calculate}
        </a>

        <a
          href="#como-funciona"
          class="inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white/80 px-7 py-4 text-center font-semibold text-slate-700 backdrop-blur transition duration-200 hover:-translate-y-0.5 hover:border-[#2d7d73]/50 hover:text-[#123b45]"
        >
          {t.discover}
        </a>
      </div>

      <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-slate-500">
        <span>✓ {t.noCommitment}</span>
        <span>✓ {t.instantResult}</span>
        <span>✓ {t.noRegistration}</span>
      </div>

      <!-- Visualización CLARISENDA -->
<div class="mt-12 hidden max-w-2xl lg:block">

  <div class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-sm">

    <div class="grid grid-cols-[1fr_auto_1.1fr_auto_1fr] items-center gap-3">

      <!-- ENTRADA -->
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
          {t.visualInput}
        </p>

        <div class="space-y-2">

          <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-[#f7f8f5] px-3 py-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-white text-[#2d7d73] shadow-sm">
              ▤
            </span>
            <span class="text-sm font-medium text-slate-600">
              {t.visualDocs}
            </span>
          </div>

          <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-[#f7f8f5] px-3 py-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-white text-[#2d7d73] shadow-sm">
              #
            </span>
            <span class="text-sm font-medium text-slate-600">
              {t.visualSheets}
            </span>
          </div>

          <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-[#f7f8f5] px-3 py-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-white text-[#2d7d73] shadow-sm">
              @
            </span>
            <span class="text-sm font-medium text-slate-600">
              {t.visualEmails}
            </span>
          </div>

        </div>
      </div>


      <!-- FLECHA -->
      <div class="pt-7 text-2xl font-light text-[#2d7d73]">
        →
      </div>


      <!-- MOTOR CLARISENDA -->
      <div class="pt-7">

        <div
          class="rounded-2xl bg-[#123b45] px-4 py-5 text-center shadow-[0_12px_30px_rgba(18,59,69,0.16)]"
        >

          <div
            class="mx-auto flex min-h-14 items-center justify-center rounded-xl bg-white px-3 py-3 shadow-sm"
          >
            <img
              src="/logo-clarisenda.png"
              alt="CLARISENDA"
              width="220"
              height="74"
              class="h-9 w-auto max-w-full object-contain"
            />
          </div>

          <p class="mt-4 text-xs leading-5 text-white/65">
            {t.visualProcessText}
          </p>

        </div>

      </div>


      <!-- FLECHA -->
      <div class="pt-7 text-xl text-[#6aa69f]">
        →
      </div>


      <!-- SALIDA -->
      <div>

        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
          {t.visualOutput}
        </p>

        <div class="rounded-xl border border-[#6aa69f]/40 bg-[#eaf4f1] p-4 shadow-sm">

          <div class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#2d7d73] text-sm font-semibold text-white">
              ✓
            </span>

            <div>
              <p class="text-sm font-semibold text-[#123b45]">
                {t.visualTraceable}
              </p>
            </div>
          </div>

          <div class="mt-3 border-t border-[#6aa69f]/20 pt-3">
            <p class="text-sm font-semibold text-[#123b45]">
              ✓ {t.visualVerifiable}
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>
      
    </div>


    <!-- Project Check -->
      <div class="flex self-start justify-center lg:pt-1">
        <ProjectCheck lang={lang} />
      </div>

  </div>
</section>




<!-- EL PROBLEMA -->
<section class="border-t border-slate-200/80 bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8 lg:py-24">

    <!-- CABECERA -->
    <div class="max-w-3xl">

      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2d7d73]">
        {t.problemLabel}
      </p>

      <h2 class="mt-4 text-3xl font-semibold tracking-[-0.025em] text-[#102f38] sm:text-4xl lg:text-[2.7rem] lg:leading-[1.08]">
        {t.problemTitle}

        <span class="text-slate-600">
          {' '}{t.problemTitleMuted}
        </span>
      </h2>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
        {t.problemIntro}
      </p>

    </div>


    <!-- PROBLEMAS -->
    <div class="mt-10 grid gap-5 sm:mt-12 lg:mt-14 md:grid-cols-3">

      <!-- INFORMACIÓN DISPERSA -->
      <article
        class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-[#f8f9f7] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#6aa69f]/50 hover:shadow-[0_18px_45px_rgba(18,59,69,0.08)]"
      >

        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#2d7d73] to-[#6aa69f]"></div>

        <div class="flex items-start justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#e5f1ee] text-[#2d7d73]"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <path d="M7 7V4.75A1.75 1.75 0 0 1 8.75 3h8.5A1.75 1.75 0 0 1 19 4.75v10.5A1.75 1.75 0 0 1 17.25 17H15" />
              <rect x="3" y="7" width="12" height="14" rx="2" />
              <path d="M6.5 11h5M6.5 14.5h5M6.5 18h3" />
            </svg>
          </div>

          <div class="flex items-center gap-2">
            

            <span class="text-sm font-semibold tracking-[0.12em] text-slate-600">
              01
            </span>
          </div>

        </div>

        <h3 class="mt-7 text-xl font-semibold tracking-tight text-[#102f38]">
          {t.problem1Title}
        </h3>

        <p class="mt-3 leading-7 text-slate-600">
          {t.problem1Text}
        </p>

      </article>


      <!-- TRABAJO REPETITIVO -->
      <article
        class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-[#f8f9f7] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#6aa69f]/50 hover:shadow-[0_18px_45px_rgba(18,59,69,0.08)]"
      >

        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#2d7d73] to-[#6aa69f]"></div>

        <div class="flex items-start justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#e5f1ee] text-[#2d7d73]"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <path d="M20 7h-5V2" />
              <path d="M4.9 17a8 8 0 0 0 13.7-2" />
              <path d="M4 17h5v5" />
              <path d="M19.1 7A8 8 0 0 0 5.4 9" />
            </svg>
          </div>

          <div class="flex items-center gap-2">
            

            <span class="text-sm font-semibold tracking-[0.12em] text-slate-600">
              02
            </span>
          </div>

        </div>

        <h3 class="mt-7 text-xl font-semibold tracking-tight text-[#102f38]">
          {t.problem2Title}
        </h3>

        <p class="mt-3 leading-7 text-slate-600">
          {t.problem2Text}
        </p>

      </article>


      <!-- EVIDENCIA DIFÍCIL DE SEGUIR -->
      <article
        class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-[#f8f9f7] p-7 transition duration-300 hover:-translate-y-1 hover:border-[#6aa69f]/50 hover:shadow-[0_18px_45px_rgba(18,59,69,0.08)]"
      >

        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#2d7d73] to-[#6aa69f]"></div>

        <div class="flex items-start justify-between">

          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#e5f1ee] text-[#2d7d73]"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-6 w-6"
              aria-hidden="true"
            >
