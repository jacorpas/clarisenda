  lang?: 'es' | 'en';
}

const {
  lang = 'es',
} = Astro.props;

const isSpanish = lang === 'es';

const t = isSpanish
  ? {
      label: 'CLARISENDA Project Check',
      title: '¿Cuánto te cuesta hoy gestionar la información de tus proyectos?',
      intro:
        'Introduce unos datos básicos. Obtendrás una estimación del coste actual, potencial de eficiencia, inversión orientativa y retorno económico.',

      deliverables: 'Entregables al mes',
      people: 'Personas implicadas',
      hours: 'Horas por persona y entregable',
      hourlyCost: 'Coste laboral por hora',
      repetitive: 'Trabajo repetitivo o administrativo',

      complexityTitle: 'Complejidad del entorno',
      complexityIntro:
        'Esto nos permite estimar qué nivel de implantación necesitaría tu caso.',

      sources: 'Fuentes de información',
      sourcesLow: '1–3 fuentes',
      sourcesMedium: '4–8 fuentes',
      sourcesHigh: 'Más de 8',

      standardization: 'Estandarización actual',
      standardizationHigh: 'Alta',
      standardizationMedium: 'Media',
      standardizationLow: 'Baja',

      integrations: 'Integraciones necesarias',
      integrationsNone: 'Ninguna',
      integrationsMedium: '1–2 integraciones',
      integrationsHigh: '3 o más',

      users: 'Usuarios de CLARISENDA',
      usersLow: '1–3 usuarios',
      usersMedium: '4–10 usuarios',
      usersHigh: 'Más de 10',

      calculate: 'Calcular rentabilidad',

      diagnosis: 'Diagnóstico mensual',
currentCost: 'Coste actual',
repetitiveWork: 'Trabajo repetitivo',

recoveryPotential: 'Potencial de recuperación',
recoveryIntro:
  'Tres escenarios orientativos según el grado de automatización alcanzable.',

conservative: 'Conservador',
expected: 'Esperado',
reference: 'Referencia',
highPotential: 'Alto potencial',
recovery: 'Recuperación',

estimate: 'Estimación CLARISENDA',
estimatedComplexity: 'Complejidad estimada',
suggestedSolution: 'Solución sugerida',

setup: 'Implantación',
monthlyService: 'Servicio mensual',
firstYearInvestment: 'Inversión primer año',
annualRecoverable: 'Potencial recuperable anual',

positiveTitle: 'Potencial económico positivo',
roiLabel: 'ROI 1er año',
paybackLabel: 'Payback',
netBenefitLabel: 'Beneficio neto',

reviewTitle: 'Este caso requiere revisión',
reviewText:
  'Con los datos introducidos, el escenario esperado no genera un retorno económico positivo durante el primer año. Eso no significa que el proyecto no sea viable, pero sería necesario revisar alcance, proceso o nivel de automatización antes de recomendar una implantación.',

opportunityLabel: 'Tu oportunidad estimada',
analysisButton: 'Analizar mi caso con CLARISENDA',
modifyButton: 'Modificar datos',
commercialNote:
  'Sin compromiso. Revisaremos los datos antes de recomendar una implantación.',

disclaimer:
  'Project Check ofrece una estimación preliminar. Los porcentajes de recuperación, precios e impacto económico no constituyen una oferta vinculante ni una garantía de ahorro. El resultado definitivo depende del análisis del proceso real.',
    }
  : {
      label: 'CLARISENDA Project Check',
      title: 'How much does managing your project information cost today?',
      intro:
        'Enter a few basic details to estimate your current cost, efficiency potential, indicative investment and expected return.',

      deliverables: 'Deliverables per month',
      people: 'People involved',
      hours: 'Hours per person and deliverable',
      hourlyCost: 'Labour cost per hour',
      repetitive: 'Repetitive or administrative work',

      complexityTitle: 'Environment complexity',
      complexityIntro:
        'This helps us estimate the implementation level your case may require.',

      sources: 'Information sources',
      sourcesLow: '1–3 sources',
      sourcesMedium: '4–8 sources',
      sourcesHigh: 'More than 8',

      standardization: 'Current standardisation',
      standardizationHigh: 'High',
      standardizationMedium: 'Medium',
      standardizationLow: 'Low',

      integrations: 'Required integrations',
      integrationsNone: 'None',
      integrationsMedium: '1–2 integrations',
      integrationsHigh: '3 or more',

      users: 'CLARISENDA users',
      usersLow: '1–3 users',
      usersMedium: '4–10 users',
      usersHigh: 'More than 10',

      calculate: 'Calculate ROI',

      diagnosis: 'Monthly assessment',
currentCost: 'Current cost',
repetitiveWork: 'Repetitive work',

recoveryPotential: 'Recovery potential',
recoveryIntro:
  'Three indicative scenarios based on the achievable level of automation.',

conservative: 'Conservative',
expected: 'Expected',
reference: 'Reference',
highPotential: 'High potential',
recovery: 'Recovery',

estimate: 'CLARISENDA estimate',
estimatedComplexity: 'Estimated complexity',
suggestedSolution: 'Suggested solution',

setup: 'Implementation',
monthlyService: 'Monthly service',
firstYearInvestment: 'First-year investment',
annualRecoverable: 'Annual recoverable potential',

positiveTitle: 'Positive economic potential',
roiLabel: 'First-year ROI',
paybackLabel: 'Payback',
netBenefitLabel: 'Net benefit',

reviewTitle: 'This case requires further review',
reviewText:
  'Based on the information provided, the expected scenario does not generate a positive return during the first year. This does not necessarily mean that the project is unviable, but its scope, process or level of automation should be reviewed before recommending an implementation.',

opportunityLabel: 'Your estimated opportunity',
analysisButton: 'Review my case with CLARISENDA',
modifyButton: 'Edit data',
commercialNote:
  'No commitment. We will review the information before recommending an implementation.',

disclaimer:
  'Project Check provides a preliminary estimate. Recovery rates, prices and economic impact do not constitute a binding offer or a guarantee of savings. Final results depend on an analysis of the actual process.',

    };
---

<div
  id="project-check"
  data-lang={lang}
  class="w-full max-w-xl scroll-mt-24 rounded-3xl border border-slate-200 bg-white p-7 shadow-[0_20px_70px_rgba(15,45,55,0.10)] sm:p-9"
>
  <div id="project-check-intro">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2d7d73]">
      {t.label}
    </p>

    <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#102f38]">
      {t.title}
    </h2>

    <p class="mt-4 leading-7 text-slate-600">
      {t.intro}
    </p>
  </div>


  <form id="project-check-form" class="mt-7 space-y-5">

  <!-- DATOS DEL PROCESO -->

  <div class="grid gap-4 sm:grid-cols-2">

    <label class="block">
      <span class="text-sm font-medium text-slate-700">
        {t.deliverables}
      </span>

      <input
        id="deliverables"
        type="number"
        min="1"
        value="10"
        required
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
      />
    </label>


    <label class="block">
      <span class="text-sm font-medium text-slate-700">
        {t.people}
      </span>

      <input
        id="people"
        type="number"
        min="1"
        value="2"
        required
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
      />
    </label>

  </div>


  <div class="grid gap-4 sm:grid-cols-2">

    <label class="block">
      <span class="text-sm font-medium text-slate-700">
        {t.hours}
      </span>

      <input
        id="hours"
        type="number"
        min="0.5"
        step="0.5"
        value="6"
        required
        class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
      />
    </label>


    <label class="block">
      <span class="text-sm font-medium text-slate-700">
        {t.hourlyCost}
      </span>

      <div class="relative mt-2">

        <input
          id="hourly-cost"
          type="number"
          min="1"
          step="1"
          value="35"
          required
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 pr-10 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
        />

        <span class="absolute right-4 top-3 text-slate-400">
          €
        </span>

      </div>
    </label>

  </div>


  <label class="block">

    <div class="flex items-center justify-between gap-5">

      <span class="text-sm font-medium text-slate-700">
        {t.repetitive}
      </span>

      <strong
        id="repetitive-value"
        class="text-[#2d7d73]"
      >
        50 %
      </strong>

    </div>

    <input
      id="repetitive"
      type="range"
      min="10"
      max="90"
      step="5"
      value="50"
      class="mt-3 w-full accent-[#2d7d73]"
    />

  </label>


  <!-- COMPLEJIDAD -->

  <div class="border-t border-slate-200 pt-6">

    <p class="font-semibold text-[#102f38]">
      {t.complexityTitle}
    </p>

    <p class="mt-1 text-sm leading-6 text-slate-500">
      {t.complexityIntro}
    </p>


    <div class="mt-5 grid gap-4 sm:grid-cols-2">

      <label class="block">

        <span class="text-sm font-medium text-slate-700">
          {t.sources}
        </span>

        <select
          id="sources"
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73]"
        >
          <option value="0">
            {t.sourcesLow}
          </option>

          <option value="1">
            {t.sourcesMedium}
          </option>

          <option value="2">
            {t.sourcesHigh}
          </option>
        </select>

      </label>


      <label class="block">

        <span class="text-sm font-medium text-slate-700">
          {t.standardization}
        </span>

        <select
          id="standardization"
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73]"
        >
          <option value="0">
            {t.standardizationHigh}
          </option>

          <option value="1" selected>
            {t.standardizationMedium}
          </option>

          <option value="2">
            {t.standardizationLow}
          </option>
        </select>

      </label>


      <label class="block">

        <span class="text-sm font-medium text-slate-700">
          {t.integrations}
        </span>

        <select
          id="integrations"
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73]"
        >
          <option value="0">
            {t.integrationsNone}
          </option>

          <option value="1">
            {t.integrationsMedium}
          </option>

          <option value="2">
            {t.integrationsHigh}
          </option>
        </select>

      </label>


      <label class="block">

        <span class="text-sm font-medium text-slate-700">
          {t.users}
        </span>

        <select
          id="users"
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73]"
        >
          <option value="0">
            {t.usersLow}
          </option>

          <option value="1">
            {t.usersMedium}
          </option>

          <option value="2">
            {t.usersHigh}
          </option>
        </select>

      </label>

    </div>

  </div>


  <button
    type="submit"
    class="w-full rounded-xl bg-[#2d7d73] px-6 py-4 font-semibold text-white transition hover:bg-[#256a62]"
  >
    {t.calculate}
  </button>

</form>


  <!-- RESULTADOS -->

  <div id="results" class="hidden">

    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#2d7d73]">
      {t.diagnosis}
    </p>


    <div class="mt-4 grid grid-cols-2 gap-3">

      <div class="rounded-xl bg-[#f7f8f5] p-4">

        <p class="text-xs font-medium text-slate-500">
          {t.currentCost}
        </p>

        <p
          id="current-cost"
          class="mt-2 text-2xl font-semibold text-[#123b45]"
        >
          —
        </p>

      </div>


      <div class="rounded-xl bg-[#f7f8f5] p-4">

        <p class="text-xs font-medium text-slate-500">
          {t.repetitiveWork}
        </p>

        <p
          id="repetitive-hours"
          class="mt-2 text-2xl font-semibold text-[#123b45]"
        >
          —
        </p>

      </div>

    </div>


    <!-- ESCENARIOS -->

    <div class="mt-7">

      <p class="text-sm font-semibold text-[#102f38]">
        {t.recoveryPotential}
      </p>

      <p class="mt-1 text-sm leading-6 text-slate-500">
        {t.recoveryIntro}
      </p>


      <div class="mt-4 grid gap-3 md:grid-cols-3">

        <div class="rounded-2xl border border-slate-200 p-4">

          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
            {t.conservative}
          </p>

          <p class="mt-3 text-sm text-slate-500">
            {t.recovery}
          </p>

          <p class="text-xl font-semibold text-[#123b45]">
            35 %
          </p>

          <p
            id="conservative-hours"
            class="mt-4 text-lg font-semibold text-[#123b45]"
          >
            —
          </p>

          <p
            id="conservative-value"
            class="mt-1 text-sm text-slate-500"
          >
            —
          </p>

        </div>


        <div class="rounded-2xl border-2 border-[#2d7d73] bg-[#eaf4f1] p-4 shadow-sm">

          <div class="flex items-center justify-between gap-2">

            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2d7d73]">
              {t.expected}
            </p>

            <span class="rounded-full bg-white px-2 py-1 text-[10px] font-semibold text-[#2d7d73]">
              {t.reference}
            </span>

          </div>

          <p class="mt-3 text-sm text-slate-500">
            {t.recovery}
          </p>

          <p class="text-xl font-semibold text-[#2d7d73]">
            60 %
          </p>

          <p
            id="expected-hours"
            class="mt-4 text-lg font-semibold text-[#2d7d73]"
          >
            —
          </p>

          <p
            id="expected-value"
            class="mt-1 text-sm font-medium text-[#2d7d73]"
          >
            —
          </p>

        </div>


        <div class="rounded-2xl border border-slate-200 p-4">

          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
            {t.highPotential}
          </p>

          <p class="mt-3 text-sm text-slate-500">
            {t.recovery}
          </p>

          <p class="text-xl font-semibold text-[#123b45]">
            80 %
          </p>

          <p
            id="high-hours"
            class="mt-4 text-lg font-semibold text-[#123b45]"
          >
            —
          </p>

          <p
            id="high-value"
            class="mt-1 text-sm text-slate-500"
          >
            —
          </p>

        </div>

      </div>

    </div>


    <!-- INVERSIÓN -->

    <div class="mt-8 border-t border-slate-200 pt-7">

      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#2d7d73]">
        {t.estimate}
      </p>


      <div class="mt-4 rounded-2xl bg-[#102f38] p-5 text-white">

        <div class="grid gap-5 sm:grid-cols-2">

          <div>

            <p class="text-xs uppercase tracking-[0.12em] text-white/60">
              {t.estimatedComplexity}
            </p>

            <p
              id="complexity"
              class="mt-1 text-xl font-semibold"
            >
              —
            </p>

          </div>


          <div>

            <p class="text-xs uppercase tracking-[0.12em] text-white/60">
              {t.suggestedSolution}
            </p>

            <p
              id="solution"
              class="mt-1 text-xl font-semibold"
            >
              —
            </p>

          </div>

        </div>

      </div>


      <div class="mt-4 grid grid-cols-2 gap-3">

        <div class="rounded-xl bg-[#f7f8f5] p-4">

          <p class="text-xs text-slate-500">
            {t.setup}
          </p>

          <p
            id="setup-price"
            class="mt-2 text-xl font-semibold text-[#123b45]"
          >
            —
          </p>

        </div>


        <div class="rounded-xl bg-[#f7f8f5] p-4">

          <p class="text-xs text-slate-500">
            {t.monthlyService}
          </p>

          <p
            id="monthly-price"
            class="mt-2 text-xl font-semibold text-[#123b45]"
          >
            —
          </p>

        </div>


        <div class="rounded-xl bg-[#f7f8f5] p-4">

          <p class="text-xs text-slate-500">
            {t.firstYearInvestment}
          </p>

          <p
            id="year-one-investment"
            class="mt-2 text-xl font-semibold text-[#123b45]"
          >
            —
          </p>

        </div>


        <div class="rounded-xl bg-[#eaf4f1] p-4">

          <p class="text-xs text-slate-500">
            {t.annualRecoverable}
          </p>

          <p
            id="annual-value"
            class="mt-2 text-xl font-semibold text-[#2d7d73]"
          >
            —
          </p>

        </div>

      </div>

    </div>


    <!-- RENTABILIDAD POSITIVA -->

    <div
      id="positive-business-case"
      class="mt-5 hidden rounded-2xl border border-[#2d7d73]/30 bg-[#eaf4f1] p-5"
    >

      <p class="text-sm font-semibold text-[#2d7d73]">
        {t.positiveTitle}
      </p>

      <div class="mt-4 grid grid-cols-3 gap-3">

        <div>

          <p class="text-xs text-slate-500">
            {t.roiLabel}
          </p>

          <p
            id="roi"
            class="mt-1 text-xl font-semibold text-[#123b45]"
          >
            —
          </p>

        </div>


        <div>

          <p class="text-xs text-slate-500">
            {t.paybackLabel}
          </p>

          <p
            id="payback"
            class="mt-1 text-xl font-semibold text-[#123b45]"
          >
            —
          </p>

        </div>


        <div>

          <p class="text-xs text-slate-500">
            {t.netBenefitLabel}
          </p>

          <p
            id="net-benefit"
            class="mt-1 text-xl font-semibold text-[#123b45]"
          >
            —
          </p>

        </div>

      </div>

    </div>


    <!-- RENTABILIDAD NEGATIVA -->

    <div
      id="negative-business-case"
      class="mt-5 hidden rounded-2xl border border-amber-300 bg-amber-50 p-5"
    >

      <p class="font-semibold text-amber-900">
        {t.reviewTitle}
      </p>

      <p class="mt-2 text-sm leading-6 text-amber-800">
        {t.reviewText}
      </p>

    </div>

<!-- SIGUIENTE PASO COMERCIAL -->

<div
  id="commercial-next-step"
  class="mt-5 rounded-2xl bg-[#102f38] p-6 text-white"
>
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#79c0b7]">
    {t.opportunityLabel}
  </p>

  <h3
    id="opportunity-title"
    class="mt-3 text-2xl font-semibold tracking-tight"
  >
    —
  </h3>

  <p
    id="opportunity-summary"
    class="mt-3 leading-7 text-white/75"
  >
    —
  </p>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row">

    <a
      id="analysis-cta"
      href="mailto:info@clarisenda.com"
      class="rounded-xl bg-white px-5 py-3 text-center font-semibold text-[#123b45] transition hover:bg-[#eaf4f1]"
    >
      {t.analysisButton}
    </a>

    <button
      id="recalculate"
      type="button"
      class="rounded-xl border border-white/25 px-5 py-3 font-semibold text-white transition hover:bg-white/10"
    >
      {t.modifyButton}
    </button>

  </div>

  <p class="mt-4 text-xs leading-5 text-white/50">
    {t.commercialNote}
  </p>
</div>


    <div class="mt-5 rounded-xl border border-slate-200 bg-white p-4">

      <p class="text-sm leading-6 text-slate-600">
        {t.disclaimer}
      </p>

    </div>

  </div>
</div>


<script>

  const form =
    document.querySelector<HTMLFormElement>('#project-check-form');

  const repetitive =
    document.querySelector<HTMLInputElement>('#repetitive');

  const repetitiveValue =
    document.querySelector<HTMLElement>('#repetitive-value');


  repetitive?.addEventListener('input', () => {

    if (repetitiveValue) {
      repetitiveValue.textContent = `${repetitive.value} %`;
    }

  });


  
  const projectCheck =
  document.querySelector<HTMLElement>(
    '#project-check'
  );


const currentLang =
  projectCheck?.dataset.lang === 'en'
    ? 'en'
    : 'es';


const locale =
  currentLang === 'en'
    ? 'en-US'
    : 'es-ES';


const jsText =
  currentLang === 'en'
    ? {
        low: 'Low',
        medium: 'Medium',
        high: 'High',

        perMonth: '/ month',
        hours: 'h',
        months: 'months',

        analysisButton: 'Review my case with CLARISENDA',
        reviewButton: 'Review my case with CLARISENDA',

        positiveOpportunity:
          'recoverable potential per year',

        reviewOpportunity:
          'The scope should be reviewed before implementation',
      }
    : {
        low: 'Baja',
        medium: 'Media',
        high: 'Alta',

        perMonth: '/ mes',
        hours: 'h',
        months: 'meses',

        analysisButton: 'Analizar mi caso con CLARISENDA',
        reviewButton: 'Revisar mi caso con CLARISENDA',

        positiveOpportunity:
          'de potencial recuperable al año',

        reviewOpportunity:
          'Conviene revisar el alcance antes de implantar',
      };


const euro = new Intl.NumberFormat(locale, {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
});


const number = new Intl.NumberFormat(locale, {
  maximumFractionDigits: 1,
});


  form?.addEventListener('submit', (event) => {

    event.preventDefault();


    /*
      DATOS DEL PROCESO
    */

    const deliverables =
      Number(
        document.querySelector<HTMLInputElement>(
          '#deliverables'
        )?.value
      ) || 0;


    const people =
      Number(
        document.querySelector<HTMLInputElement>(
          '#people'
        )?.value
      ) || 0;


    const hours =
      Number(
        document.querySelector<HTMLInputElement>(
          '#hours'
        )?.value
      ) || 0;


    const hourlyCost =
      Number(
        document.querySelector<HTMLInputElement>(
          '#hourly-cost'
        )?.value
      ) || 0;


    const repetitivePercent =
      Number(repetitive?.value) / 100;


    /*
      COSTE ACTUAL
    */

    const totalHours =
      deliverables *
      people *
      hours;


    const currentCost =
      totalHours *
      hourlyCost;


    const repetitiveHours =
      totalHours *
      repetitivePercent;


    /*
      ESCENARIOS DE RECUPERACIÓN
    */

    const conservativeRate = 0.35;
    const expectedRate = 0.60;
    const highRate = 0.80;


    const conservativeHours =
      repetitiveHours *
      conservativeRate;


    const expectedHours =
      repetitiveHours *
      expectedRate;


    const highHours =
      repetitiveHours *
      highRate;


    const conservativeValue =
      conservativeHours *
      hourlyCost;


    const expectedValue =
      expectedHours *
      hourlyCost;


    const highValue =
      highHours *
      hourlyCost;


    /*
      COMPLEJIDAD
    */

    const sources =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#sources'
        )?.value
      ) || 0;


    const standardization =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#standardization'
        )?.value
      ) || 0;


    const integrations =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#integrations'
        )?.value
      ) || 0;


    const users =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#users'
        )?.value
      ) || 0;


    const complexityScore =
      sources +
      standardization +
      integrations +
      users;


    let complexity = '';
    let solution = '';
    let setupPrice = 0;
    let monthlyPrice = 0;


    /*
      PRICING ENGINE v0.1
    */

    if (complexityScore <= 2) {

      complexity = jsText.low;
      solution = 'Project Evidence';
      setupPrice = 1490;
      monthlyPrice = 290;

    } else if (complexityScore <= 5) {

      complexity = jsText.medium;
      solution = 'Project Evidence + Audit Ready';
      setupPrice = 2900;
      monthlyPrice = 590;

    } else {

      complexity = jsText.high;
      solution = 'Project Control';
      setupPrice = 4900;
      monthlyPrice = 990;

    }


    /*
      BUSINESS CASE
    */

    const yearOneInvestment =
      setupPrice +
      monthlyPrice * 12;


    const annualRecoverableValue =
      expectedValue * 12;


    const netBenefit =
      annualRecoverableValue -
      yearOneInvestment;


    const roi =
      yearOneInvestment > 0
        ? (netBenefit / yearOneInvestment) * 100
        : 0;


    const monthlyNetValue =
      expectedValue -
      monthlyPrice;


    const payback =
      monthlyNetValue > 0
        ? setupPrice / monthlyNetValue
        : null;


    /*
      ACTUALIZAR DIAGNÓSTICO
    */

    const currentCostElement =
      document.querySelector<HTMLElement>(
        '#current-cost'
      );


    const repetitiveHoursElement =
      document.querySelector<HTMLElement>(
        '#repetitive-hours'
      );


    if (currentCostElement) {
      currentCostElement.textContent =
        euro.format(currentCost);
    }


    if (repetitiveHoursElement) {
      repetitiveHoursElement.textContent =
        `${number.format(repetitiveHours)} h`;
    }


    /*
      ESCENARIO CONSERVADOR
    */

    const conservativeHoursElement =
      document.querySelector<HTMLElement>(
        '#conservative-hours'
      );


    const conservativeValueElement =
      document.querySelector<HTMLElement>(
        '#conservative-value'
      );


    if (conservativeHoursElement) {

      conservativeHoursElement.textContent =
        `${number.format(conservativeHours)} h`;

    }


    if (conservativeValueElement) {

      conservativeValueElement.textContent =
        `${euro.format(conservativeValue)} ${jsText.perMonth}`;

    }


    /*
      ESCENARIO ESPERADO
    */

    const expectedHoursElement =
      document.querySelector<HTMLElement>(
        '#expected-hours'
      );


    const expectedValueElement =
      document.querySelector<HTMLElement>(
        '#expected-value'
      );


    if (expectedHoursElement) {

      expectedHoursElement.textContent =
        `${number.format(expectedHours)} h`;

    }


    if (expectedValueElement) {

      expectedValueElement.textContent =
        `${euro.format(expectedValue)} ${jsText.perMonth}`;

    }


    /*
      ESCENARIO ALTO
    */

    const highHoursElement =
      document.querySelector<HTMLElement>(
        '#high-hours'
      );


    const highValueElement =
      document.querySelector<HTMLElement>(
        '#high-value'
      );


    if (highHoursElement) {

      highHoursElement.textContent =
        `${number.format(highHours)} h`;

    }


    if (highValueElement) {

      highValueElement.textContent =
        `${euro.format(highValue)} ${jsText.perMonth}`;

    }


    /*
      RESULTADO COMERCIAL
    */

    const complexityElement =
      document.querySelector<HTMLElement>(
        '#complexity'
      );


    const solutionElement =
      document.querySelector<HTMLElement>(
        '#solution'
      );


    const setupPriceElement =
      document.querySelector<HTMLElement>(
        '#setup-price'
      );


    const monthlyPriceElement =
      document.querySelector<HTMLElement>(
        '#monthly-price'
      );


    const yearOneInvestmentElement =
      document.querySelector<HTMLElement>(
        '#year-one-investment'
      );


    const annualValueElement =
      document.querySelector<HTMLElement>(
        '#annual-value'
      );


    if (complexityElement) {
      complexityElement.textContent =
        complexity;
    }


    if (solutionElement) {
      solutionElement.textContent =
        solution;
    }


    if (setupPriceElement) {
      setupPriceElement.textContent =
        euro.format(setupPrice);
    }


    if (monthlyPriceElement) {
      monthlyPriceElement.textContent =
        `${euro.format(monthlyPrice)} ${jsText.perMonth}`;
    }


    if (yearOneInvestmentElement) {
      yearOneInvestmentElement.textContent =
        euro.format(yearOneInvestment);
    }


    if (annualValueElement) {
      annualValueElement.textContent =
        euro.format(annualRecoverableValue);
    }


    /*
      RENTABILIDAD
    */

    const positivePanel =
      document.querySelector<HTMLElement>(
        '#positive-business-case'
      );


    const negativePanel =
      document.querySelector<HTMLElement>(
        '#negative-business-case'
      );


    if (netBenefit > 0 && payback !== null) {

      positivePanel?.classList.remove('hidden');
      negativePanel?.classList.add('hidden');


      const roiElement =
        document.querySelector<HTMLElement>(
          '#roi'
        );


      const paybackElement =
        document.querySelector<HTMLElement>(
          '#payback'
        );


      const netBenefitElement =
        document.querySelector<HTMLElement>(
          '#net-benefit'
        );


      if (roiElement) {

        roiElement.textContent =
          `${Math.round(roi)} %`;

      }


      if (paybackElement) {

        paybackElement.textContent =
          `${number.format(payback)} ${jsText.months}`;

      }


      if (netBenefitElement) {

        netBenefitElement.textContent =
          euro.format(netBenefit);

      }

    } else {

      positivePanel?.classList.add('hidden');
      negativePanel?.classList.remove('hidden');

    }


/*
  RESUMEN COMERCIAL PERSONALIZADO
*/

const opportunityTitle =
  document.querySelector<HTMLElement>(
    '#opportunity-title'
  );

const opportunitySummary =
  document.querySelector<HTMLElement>(
    '#opportunity-summary'
  );

const analysisCta =
  document.querySelector<HTMLAnchorElement>(
    '#analysis-cta'
  );


if (netBenefit > 0 && payback !== null) {

  if (opportunityTitle) {
    opportunityTitle.textContent =
      `${euro.format(annualRecoverableValue)} ${jsText.positiveOpportunity}`;
  }

  if (opportunitySummary) {

    if (currentLang === 'en') {

      opportunitySummary.textContent =
        `For an environment with ${complexity.toLowerCase()} complexity, ` +
        `CLARISENDA recommends ${solution}. ` +
        `The preliminary estimate indicates a first-year ROI of ` +
        `${Math.round(roi)}% and an estimated payback period of ` +
        `${number.format(payback)} ${jsText.months}.`;

    } else {

      opportunitySummary.textContent =
        `Para un entorno de complejidad ${complexity.toLowerCase()}, ` +
        `CLARISENDA recomienda ${solution}. ` +
        `La estimación preliminar arroja un ROI del ${Math.round(roi)} % ` +
        `durante el primer año y una amortización aproximada de ` +
        `${number.format(payback)} ${jsText.months}.`;

    }

  }

  if (analysisCta) {
    analysisCta.textContent =
      jsText.analysisButton;
  }

} else {

  if (opportunityTitle) {
    opportunityTitle.textContent =
      jsText.reviewOpportunity;
  }

  if (opportunitySummary) {

    if (currentLang === 'en') {

      opportunitySummary.textContent =
        `The process has an estimated recoverable potential of ` +
        `${euro.format(annualRecoverableValue)} per year, but the estimated ` +
        `investment for a ${complexity.toLowerCase()} complexity solution ` +
        `does not generate a positive first-year return. ` +
        `We recommend reviewing the scope before making an implementation decision.`;

    } else {

      opportunitySummary.textContent =
        `El proceso presenta un potencial recuperable estimado de ` +
        `${euro.format(annualRecoverableValue)} al año, pero la inversión ` +
        `estimada para una solución de complejidad ${complexity.toLowerCase()} ` +
        `no obtiene retorno positivo durante el primer año. ` +
        `Recomendamos analizar el alcance antes de tomar una decisión.`;

    }

  }

  if (analysisCta) {
    analysisCta.textContent =
      jsText.reviewButton;
  }

}


/*
  PREPARAR CORREO CON EL DIAGNÓSTICO
*/

if (analysisCta) {

  let subject = '';
  let body = '';

  if (currentLang === 'en') {

    subject =
      `[PROJECT CHECK] CLARISENDA - ${complexity} complexity`;

    body =
`Hello CLARISENDA,

I have completed a Project Check and would like to review the result.

ASSESSMENT

Estimated current cost:
${euro.format(currentCost)} / month

Repetitive work:
${number.format(repetitiveHours)} hours / month

Expected recoverable potential:
${euro.format(expectedValue)} / month
${euro.format(annualRecoverableValue)} / year

Estimated complexity:
${complexity}

Suggested solution:
${solution}

Indicative implementation:
${euro.format(setupPrice)}

Indicative monthly service:
${euro.format(monthlyPrice)}

Estimated first-year investment:
${euro.format(yearOneInvestment)}

Estimated first-year ROI:
${Math.round(roi)}%

Estimated payback:
${payback !== null
  ? number.format(payback) + ' months'
  : 'Requires review'}

I would like to receive a more detailed analysis.

Thank you.`;

  } else {

    subject =
      `[PROJECT CHECK] CLARISENDA - Complejidad ${complexity}`;

    body =
`Hola CLARISENDA,

He realizado un Project Check y me gustaría analizar el resultado.

DATOS DEL DIAGNÓSTICO

Coste actual estimado:
${euro.format(currentCost)} / mes

Trabajo repetitivo:
${number.format(repetitiveHours)} horas / mes

Potencial recuperable esperado:
${euro.format(expectedValue)} / mes
${euro.format(annualRecoverableValue)} / año

Complejidad estimada:
${complexity}

Solución sugerida:
${solution}

Implantación orientativa:
${euro.format(setupPrice)}

Servicio mensual orientativo:
${euro.format(monthlyPrice)}

Inversión estimada primer año:
${euro.format(yearOneInvestment)}

ROI estimado primer año:
${Math.round(roi)} %

Payback estimado:
${payback !== null
  ? number.format(payback) + ' meses'
  : 'Requiere revisión'}

Me gustaría recibir un análisis más detallado.

Gracias.`;

  }

  analysisCta.href =
    `mailto:info@clarisenda.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

/*
  MOSTRAR RESULTADOS
*/

const introElement =
  document.querySelector<HTMLElement>(
    '#project-check-intro'
  );

const resultsElement =
  document.querySelector<HTMLElement>(
    '#results'
  );


introElement?.classList.add('hidden');
form?.classList.add('hidden');

resultsElement?.classList.remove('hidden');


projectCheck?.scrollIntoView({
  behavior: 'smooth',
  block: 'start',
});

});


const recalculateButton =
  document.querySelector<HTMLButtonElement>(
    '#recalculate'
  );


recalculateButton?.addEventListener('click', () => {

  const resultsElement =
  document.querySelector<HTMLElement>(
    '#results'
  );

const introElement =
  document.querySelector<HTMLElement>(
    '#project-check-intro'
  );


/*
  VOLVER AL FORMULARIO
*/

resultsElement?.classList.add('hidden');

introElement?.classList.remove('hidden');
form?.classList.remove('hidden');


  /*
    VOLVER A PROJECT CHECK
  */

  projectCheck?.scrollIntoView({
    behavior: 'smooth',
    block: 'start',
  });


  /*
    FOCALIZAR PRIMER CAMPO
  */

  setTimeout(() => {

    document
      .querySelector<HTMLInputElement>(
        '#deliverables'
      )
      ?.focus();

  }, 500);

});

</script>

