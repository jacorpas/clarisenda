    </div>

<!-- SIGUIENTE PASO COMERCIAL -->

<div
  id="commercial-next-step"
  class="mt-5 rounded-2xl bg-[#102f38] p-6 text-white"
>
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#79c0b7]">
    Tu oportunidad estimada
  </p>

  <h3
    id="opportunity-title"
    class="mt-3 text-2xl font-semibold tracking-tight"
  >
    —
  </h3>

  <p
    id="opportunity-summary"
    class="mt-3 leading-7 text-white/75"
  >
    —
  </p>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row">

    <a
      id="analysis-cta"
      href="mailto:info@clarisenda.com"
      class="rounded-xl bg-white px-5 py-3 text-center font-semibold text-[#123b45] transition hover:bg-[#eaf4f1]"
    >
      Solicitar análisis detallado
    </a>

    <button
      id="recalculate"
      type="button"
      class="rounded-xl border border-white/25 px-5 py-3 font-semibold text-white transition hover:bg-white/10"
    >
      Modificar datos
    </button>

  </div>

  <p class="mt-4 text-xs leading-5 text-white/50">
    Sin compromiso. Revisaremos los datos antes de recomendar una implantación.
  </p>
</div>


    <div class="mt-5 rounded-xl border border-slate-200 bg-white p-4">

      <p class="text-sm leading-6 text-slate-600">
        Project Check ofrece una estimación preliminar. Los porcentajes
        de recuperación, precios e impacto económico no constituyen una
        oferta vinculante ni una garantía de ahorro. El resultado definitivo
        depende del análisis del proceso real.
      </p>

    </div>

  </div>
</div>


<script>

  const form =
    document.querySelector<HTMLFormElement>('#project-check-form');

  const repetitive =
    document.querySelector<HTMLInputElement>('#repetitive');

  const repetitiveValue =
    document.querySelector<HTMLElement>('#repetitive-value');


  repetitive?.addEventListener('input', () => {

    if (repetitiveValue) {
      repetitiveValue.textContent = `${repetitive.value} %`;
    }

  });


  const euro = new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  });


  const number = new Intl.NumberFormat('es-ES', {
    maximumFractionDigits: 1,
  });


  form?.addEventListener('submit', (event) => {

    event.preventDefault();


    /*
      DATOS DEL PROCESO
    */

    const deliverables =
      Number(
        document.querySelector<HTMLInputElement>(
          '#deliverables'
        )?.value
      ) || 0;


    const people =
      Number(
        document.querySelector<HTMLInputElement>(
          '#people'
        )?.value
      ) || 0;


    const hours =
      Number(
        document.querySelector<HTMLInputElement>(
          '#hours'
        )?.value
      ) || 0;


    const hourlyCost =
      Number(
        document.querySelector<HTMLInputElement>(
          '#hourly-cost'
        )?.value
      ) || 0;


    const repetitivePercent =
      Number(repetitive?.value) / 100;


    /*
      COSTE ACTUAL
    */

    const totalHours =
      deliverables *
      people *
      hours;


    const currentCost =
      totalHours *
      hourlyCost;


    const repetitiveHours =
      totalHours *
      repetitivePercent;


    /*
      ESCENARIOS DE RECUPERACIÓN
    */

    const conservativeRate = 0.35;
    const expectedRate = 0.60;
    const highRate = 0.80;


    const conservativeHours =
      repetitiveHours *
      conservativeRate;


    const expectedHours =
      repetitiveHours *
      expectedRate;


    const highHours =
      repetitiveHours *
      highRate;


    const conservativeValue =
      conservativeHours *
      hourlyCost;


    const expectedValue =
      expectedHours *
      hourlyCost;


    const highValue =
      highHours *
      hourlyCost;


    /*
      COMPLEJIDAD
    */

    const sources =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#sources'
        )?.value
      ) || 0;


    const standardization =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#standardization'
        )?.value
      ) || 0;


    const integrations =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#integrations'
        )?.value
      ) || 0;


    const users =
      Number(
        document.querySelector<HTMLSelectElement>(
          '#users'
        )?.value
      ) || 0;


    const complexityScore =
      sources +
      standardization +
      integrations +
      users;


    let complexity = '';
    let solution = '';
    let setupPrice = 0;
    let monthlyPrice = 0;


    /*
      PRICING ENGINE v0.1
    */

    if (complexityScore <= 2) {

      complexity = 'Baja';
      solution = 'Project Evidence';
      setupPrice = 1490;
      monthlyPrice = 290;

    } else if (complexityScore <= 5) {

      complexity = 'Media';
      solution = 'Project Evidence + Audit Ready';
      setupPrice = 2900;
      monthlyPrice = 590;

    } else {

      complexity = 'Alta';
      solution = 'Project Control';
      setupPrice = 4900;
      monthlyPrice = 990;

    }


    /*
      BUSINESS CASE
    */

    const yearOneInvestment =
      setupPrice +
      monthlyPrice * 12;


    const annualRecoverableValue =
      expectedValue * 12;


    const netBenefit =
      annualRecoverableValue -
      yearOneInvestment;


    const roi =
      yearOneInvestment > 0
        ? (netBenefit / yearOneInvestment) * 100
        : 0;


    const monthlyNetValue =
      expectedValue -
      monthlyPrice;


    const payback =
      monthlyNetValue > 0
        ? setupPrice / monthlyNetValue
        : null;


    /*
      ACTUALIZAR DIAGNÓSTICO
    */

    const currentCostElement =
      document.querySelector<HTMLElement>(
        '#current-cost'
      );


    const repetitiveHoursElement =
      document.querySelector<HTMLElement>(
        '#repetitive-hours'
      );


    if (currentCostElement) {
      currentCostElement.textContent =
        euro.format(currentCost);
    }


    if (repetitiveHoursElement) {
      repetitiveHoursElement.textContent =
        `${number.format(repetitiveHours)} h`;
    }


    /*
      ESCENARIO CONSERVADOR
    */

    const conservativeHoursElement =
      document.querySelector<HTMLElement>(
        '#conservative-hours'
      );


    const conservativeValueElement =
      document.querySelector<HTMLElement>(
        '#conservative-value'
      );


    if (conservativeHoursElement) {

      conservativeHoursElement.textContent =
        `${number.format(conservativeHours)} h`;

    }


    if (conservativeValueElement) {

      conservativeValueElement.textContent =
        `${euro.format(conservativeValue)} / mes`;

    }


    /*
      ESCENARIO ESPERADO
    */

    const expectedHoursElement =
      document.querySelector<HTMLElement>(
        '#expected-hours'
      );


    const expectedValueElement =
      document.querySelector<HTMLElement>(
        '#expected-value'
      );


    if (expectedHoursElement) {

      expectedHoursElement.textContent =
        `${number.format(expectedHours)} h`;

    }


    if (expectedValueElement) {

      expectedValueElement.textContent =
        `${euro.format(expectedValue)} / mes`;

    }


    /*
      ESCENARIO ALTO
    */

    const highHoursElement =
      document.querySelector<HTMLElement>(
        '#high-hours'
      );


    const highValueElement =
      document.querySelector<HTMLElement>(
        '#high-value'
      );


    if (highHoursElement) {

      highHoursElement.textContent =
        `${number.format(highHours)} h`;

    }


    if (highValueElement) {

      highValueElement.textContent =
        `${euro.format(highValue)} / mes`;

    }


    /*
      RESULTADO COMERCIAL
    */

    const complexityElement =
      document.querySelector<HTMLElement>(
        '#complexity'
      );


    const solutionElement =
      document.querySelector<HTMLElement>(
        '#solution'
      );


    const setupPriceElement =
      document.querySelector<HTMLElement>(
        '#setup-price'
      );


    const monthlyPriceElement =
      document.querySelector<HTMLElement>(
        '#monthly-price'
      );


    const yearOneInvestmentElement =
      document.querySelector<HTMLElement>(
        '#year-one-investment'
      );


    const annualValueElement =
      document.querySelector<HTMLElement>(
        '#annual-value'
      );


    if (complexityElement) {
      complexityElement.textContent =
        complexity;
    }


    if (solutionElement) {
      solutionElement.textContent =
        solution;
    }


    if (setupPriceElement) {
      setupPriceElement.textContent =
        euro.format(setupPrice);
    }


    if (monthlyPriceElement) {
      monthlyPriceElement.textContent =
        `${euro.format(monthlyPrice)} / mes`;
    }


    if (yearOneInvestmentElement) {
      yearOneInvestmentElement.textContent =
        euro.format(yearOneInvestment);
    }


    if (annualValueElement) {
      annualValueElement.textContent =
        euro.format(annualRecoverableValue);
    }


    /*
      RENTABILIDAD
    */

    const positivePanel =
      document.querySelector<HTMLElement>(
        '#positive-business-case'
      );


    const negativePanel =
      document.querySelector<HTMLElement>(
        '#negative-business-case'
      );


    if (netBenefit > 0 && payback !== null) {

      positivePanel?.classList.remove('hidden');
      negativePanel?.classList.add('hidden');


      const roiElement =
        document.querySelector<HTMLElement>(
          '#roi'
        );


      const paybackElement =
        document.querySelector<HTMLElement>(
          '#payback'
        );


      const netBenefitElement =
        document.querySelector<HTMLElement>(
          '#net-benefit'
        );


      if (roiElement) {

        roiElement.textContent =
          `${Math.round(roi)} %`;

      }


      if (paybackElement) {

        paybackElement.textContent =
          `${number.format(payback)} meses`;

      }


      if (netBenefitElement) {

        netBenefitElement.textContent =
          euro.format(netBenefit);

      }

    } else {

      positivePanel?.classList.add('hidden');
      negativePanel?.classList.remove('hidden');

    }


     /*
  RESUMEN COMERCIAL PERSONALIZADO
*/

const opportunityTitle =
  document.querySelector<HTMLElement>(
    '#opportunity-title'
  );

const opportunitySummary =
  document.querySelector<HTMLElement>(
    '#opportunity-summary'
  );

const analysisCta =
  document.querySelector<HTMLAnchorElement>(
    '#analysis-cta'
  );


if (netBenefit > 0 && payback !== null) {

  if (opportunityTitle) {
    opportunityTitle.textContent =
      `${euro.format(annualRecoverableValue)} de potencial recuperable al año`;
  }

  if (opportunitySummary) {
    opportunitySummary.textContent =
      `Para un entorno de complejidad ${complexity.toLowerCase()}, ` +
      `CLARISENDA recomienda ${solution}. ` +
      `La estimación preliminar arroja un ROI del ${Math.round(roi)} % ` +
      `durante el primer año y una amortización aproximada de ` +
      `${number.format(payback)} meses.`;
  }

  if (analysisCta) {
    analysisCta.textContent =
      'Solicitar análisis detallado';
  }

} else {

  if (opportunityTitle) {
    opportunityTitle.textContent =
      'Conviene revisar el alcance antes de implantar';
  }

  if (opportunitySummary) {
    opportunitySummary.textContent =
      `El proceso presenta un potencial recuperable estimado de ` +
      `${euro.format(annualRecoverableValue)} al año, pero la inversión ` +
      `estimada para una solución de complejidad ${complexity.toLowerCase()} ` +
      `no obtiene retorno positivo durante el primer año. ` +
      `Recomendamos analizar el alcance antes de tomar una decisión.`;
  }

  if (analysisCta) {
    analysisCta.textContent =
      'Revisar mi caso con CLARISENDA';
  }

}


/*
  PREPARAR CORREO CON EL DIAGNÓSTICO
*/

if (analysisCta) {

  const subject =
    `Project Check CLARISENDA - Complejidad ${complexity}`;


  const body =
`Hola CLARISENDA,

He realizado un Project Check y me gustaría analizar el resultado.

DATOS DEL DIAGNÓSTICO

Coste actual estimado:
${euro.format(currentCost)} / mes

Trabajo repetitivo:
${number.format(repetitiveHours)} horas / mes

Potencial recuperable esperado:
${euro.format(expectedValue)} / mes
${euro.format(annualRecoverableValue)} / año

Complejidad estimada:
${complexity}

Solución sugerida:
${solution}

Implantación orientativa:
${euro.format(setupPrice)}

Servicio mensual orientativo:
${euro.format(monthlyPrice)}

Inversión estimada primer año:
${euro.format(yearOneInvestment)}

ROI estimado primer año:
${Math.round(roi)} %

Payback estimado:
${payback !== null ? number.format(payback) + ' meses' : 'Requiere revisión'}

Me gustaría recibir un análisis más detallado.

Gracias.`;

  analysisCta.href =
    `mailto:info@clarisenda.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

}

/*
  MOSTRAR RESULTADOS
*/

document
  .querySelector('#results')
  ?.classList.remove('hidden');

});


const recalculateButton =
  document.querySelector<HTMLButtonElement>(
    '#recalculate'
  );

recalculateButton?.addEventListener('click', () => {

  form?.scrollIntoView({
    behavior: 'smooth',
    block: 'start',
  });

  setTimeout(() => {
    document
      .querySelector<HTMLInputElement>('#deliverables')
      ?.focus();
  }, 500);

});

</script>

