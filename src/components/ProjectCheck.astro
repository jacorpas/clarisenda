<div
  id="project-check"
  class="w-full max-w-xl rounded-3xl border border-slate-200 bg-white p-7 shadow-[0_20px_70px_rgba(15,45,55,0.10)] sm:p-9"
>
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#2d7d73]">
      CLARISENDA Project Check
    </p>

    <h2 class="mt-3 text-2xl font-semibold tracking-tight text-[#102f38]">
      ¿Cuánto te cuesta hoy gestionar la información de tus proyectos?
    </h2>

    <p class="mt-4 leading-7 text-slate-600">
      Introduce unos datos básicos. El cálculo se realiza directamente
      en tu navegador y verás el resultado al instante.
    </p>
  </div>

  <form id="project-check-form" class="mt-7 space-y-5">

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-medium text-slate-700">
          Entregables al mes
        </span>

        <input
          id="deliverables"
          type="number"
          min="1"
          value="10"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
        />
      </label>

      <label class="block">
        <span class="text-sm font-medium text-slate-700">
          Personas implicadas
        </span>

        <input
          id="people"
          type="number"
          min="1"
          value="2"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
        />
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-sm font-medium text-slate-700">
          Horas por persona y entregable
        </span>

        <input
          id="hours"
          type="number"
          min="0.5"
          step="0.5"
          value="6"
          required
          class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
        />
      </label>

      <label class="block">
        <span class="text-sm font-medium text-slate-700">
          Coste laboral por hora
        </span>

        <div class="relative mt-2">
          <input
            id="hourly-cost"
            type="number"
            min="1"
            step="1"
            value="35"
            required
            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 pr-10 text-slate-900 outline-none transition focus:border-[#2d7d73] focus:ring-2 focus:ring-[#2d7d73]/15"
          />

          <span class="absolute right-4 top-3 text-slate-400">€</span>
        </div>
      </label>
    </div>

    <label class="block">
      <div class="flex items-center justify-between gap-5">
        <span class="text-sm font-medium text-slate-700">
          Trabajo repetitivo o administrativo
        </span>

        <strong id="repetitive-value" class="text-[#2d7d73]">
          50 %
        </strong>
      </div>

      <input
        id="repetitive"
        type="range"
        min="10"
        max="90"
        step="5"
        value="50"
        class="mt-3 w-full accent-[#2d7d73]"
      />
    </label>

    <button
      type="submit"
      class="w-full rounded-xl bg-[#2d7d73] px-6 py-4 font-semibold text-white transition hover:bg-[#256a62]"
    >
      Calcular
    </button>

  </form>


  <div id="results" class="mt-7 hidden border-t border-slate-200 pt-7">

  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-[#2d7d73]">
    Diagnóstico mensual
  </p>

  <div class="mt-4 grid grid-cols-2 gap-3">
    <div class="rounded-xl bg-[#f7f8f5] p-4">
      <p class="text-xs font-medium text-slate-500">
        Coste actual
      </p>

      <p
        id="current-cost"
        class="mt-2 text-2xl font-semibold text-[#123b45]"
      >
        —
      </p>
    </div>

    <div class="rounded-xl bg-[#f7f8f5] p-4">
      <p class="text-xs font-medium text-slate-500">
        Trabajo repetitivo
      </p>

      <p
        id="repetitive-hours"
        class="mt-2 text-2xl font-semibold text-[#123b45]"
      >
        —
      </p>
    </div>
  </div>


  <div class="mt-7">
    <p class="text-sm font-semibold text-[#102f38]">
      Potencial de recuperación
    </p>

    <p class="mt-1 text-sm leading-6 text-slate-500">
      Tres escenarios orientativos según el grado de automatización
      alcanzable en el proceso analizado.
    </p>

    <div class="mt-4 grid gap-3 md:grid-cols-3">

      <!-- Conservador -->
      <div class="rounded-2xl border border-slate-200 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
          Conservador
        </p>

        <p class="mt-3 text-sm text-slate-500">
          Recuperación
        </p>

        <p class="text-xl font-semibold text-[#123b45]">
          35 %
        </p>

        <p
          id="conservative-hours"
          class="mt-4 text-lg font-semibold text-[#123b45]"
        >
          —
        </p>

        <p
          id="conservative-value"
          class="mt-1 text-sm text-slate-500"
        >
          —
        </p>
      </div>


      <!-- Esperado -->
      <div class="rounded-2xl border-2 border-[#2d7d73] bg-[#eaf4f1] p-4 shadow-sm">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#2d7d73]">
            Esperado
          </p>

          <span class="rounded-full bg-white px-2 py-1 text-[10px] font-semibold text-[#2d7d73]">
            Referencia
          </span>
        </div>

        <p class="mt-3 text-sm text-slate-500">
          Recuperación
        </p>

        <p class="text-xl font-semibold text-[#2d7d73]">
          60 %
        </p>

        <p
          id="expected-hours"
          class="mt-4 text-lg font-semibold text-[#2d7d73]"
        >
          —
        </p>

        <p
          id="expected-value"
          class="mt-1 text-sm font-medium text-[#2d7d73]"
        >
          —
        </p>
      </div>


      <!-- Alto potencial -->
      <div class="rounded-2xl border border-slate-200 p-4">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
          Alto potencial
        </p>

        <p class="mt-3 text-sm text-slate-500">
          Recuperación
        </p>

        <p class="text-xl font-semibold text-[#123b45]">
          80 %
        </p>

        <p
          id="high-hours"
          class="mt-4 text-lg font-semibold text-[#123b45]"
        >
          —
        </p>

        <p
          id="high-value"
          class="mt-1 text-sm text-slate-500"
        >
          —
        </p>
      </div>

    </div>
  </div>


  <div class="mt-5 rounded-xl border border-slate-200 bg-white p-4">
    <p class="text-sm leading-6 text-slate-600">
      Estos valores representan potencial de eficiencia, no ahorro
      garantizado. El resultado definitivo dependerá de la estructura,
      calidad y nivel de estandarización de cada proceso.
    </p>
  </div>

</div>
</div>


<script>
  const form = document.querySelector<HTMLFormElement>(
    '#project-check-form'
  );

  const repetitive = document.querySelector<HTMLInputElement>(
    '#repetitive'
  );

  const repetitiveValue = document.querySelector<HTMLElement>(
    '#repetitive-value'
  );

  repetitive?.addEventListener('input', () => {
    if (repetitiveValue) {
      repetitiveValue.textContent = `${repetitive.value} %`;
    }
  });

  const euro = new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  });

  const number = new Intl.NumberFormat('es-ES', {
    maximumFractionDigits: 1,
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const deliverables =
      Number(
        document.querySelector<HTMLInputElement>('#deliverables')?.value
      ) || 0;

    const people =
      Number(
        document.querySelector<HTMLInputElement>('#people')?.value
      ) || 0;

    const hours =
      Number(
        document.querySelector<HTMLInputElement>('#hours')?.value
      ) || 0;

    const hourlyCost =
      Number(
        document.querySelector<HTMLInputElement>('#hourly-cost')?.value
      ) || 0;

    const repetitivePercent =
      Number(repetitive?.value) / 100;

    /*
      Horas mensuales totales empleadas en los entregables.
    */
    const totalHours =
      deliverables * people * hours;

    /*
      Coste económico actual.
    */
    const currentCost =
      totalHours * hourlyCost;

    /*
      Horas que corresponden al trabajo declarado como
      repetitivo o administrativo.
    */
    const repetitiveHours =
      totalHours * repetitivePercent;

    /*
  Escenarios de recuperación sobre las horas
  identificadas como repetitivas.
*/
const conservativeRate = 0.35;
const expectedRate = 0.60;
const highRate = 0.80;

const conservativeHours =
  repetitiveHours * conservativeRate;

const expectedHours =
  repetitiveHours * expectedRate;

const highHours =
  repetitiveHours * highRate;

const conservativeValue =
  conservativeHours * hourlyCost;

const expectedValue =
  expectedHours * hourlyCost;

const highValue =
  highHours * hourlyCost;


/* Elementos generales */

const currentCostElement =
  document.querySelector<HTMLElement>('#current-cost');

const repetitiveHoursElement =
  document.querySelector<HTMLElement>('#repetitive-hours');


/* Escenario conservador */

const conservativeHoursElement =
  document.querySelector<HTMLElement>('#conservative-hours');

const conservativeValueElement =
  document.querySelector<HTMLElement>('#conservative-value');


/* Escenario esperado */

const expectedHoursElement =
  document.querySelector<HTMLElement>('#expected-hours');

const expectedValueElement =
  document.querySelector<HTMLElement>('#expected-value');


/* Escenario alto potencial */

const highHoursElement =
  document.querySelector<HTMLElement>('#high-hours');

const highValueElement =
  document.querySelector<HTMLElement>('#high-value');


if (currentCostElement) {
  currentCostElement.textContent =
    euro.format(currentCost);
}

if (repetitiveHoursElement) {
  repetitiveHoursElement.textContent =
    `${number.format(repetitiveHours)} h`;
}

if (conservativeHoursElement) {
  conservativeHoursElement.textContent =
    `${number.format(conservativeHours)} h`;
}

if (conservativeValueElement) {
  conservativeValueElement.textContent =
    `${euro.format(conservativeValue)} / mes`;
}

if (expectedHoursElement) {
  expectedHoursElement.textContent =
    `${number.format(expectedHours)} h`;
}

if (expectedValueElement) {
  expectedValueElement.textContent =
    `${euro.format(expectedValue)} / mes`;
}

if (highHoursElement) {
  highHoursElement.textContent =
    `${number.format(highHours)} h`;
}

if (highValueElement) {
  highValueElement.textContent =
    `${euro.format(highValue)} / mes`;
}

    document
      .querySelector('#results')
      ?.classList.remove('hidden');
  });
</script>
