---
import Layout from '../layouts/Layout.astro';
import ProjectCheck from '../components/ProjectCheck.astro';
---

<Layout
  title="CLARISENDA | Cada dato. Su evidencia."
  description="Convierte información dispersa en conocimiento operativo verificable. Reduce trabajo repetitivo, mejora la trazabilidad y prepara tus proyectos para entregar, controlar y auditar."
>
  <div class="min-h-screen bg-[#f7f8f5] text-slate-900">

    <!-- CABECERA -->
    <header class="border-b border-slate-200/80 bg-[#f7f8f5]/95">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">

        <a href="/" class="text-xl font-bold tracking-[0.16em] text-[#123b45]">
          CLARISENDA
        </a>

        <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 md:flex">
          <a href="#como-funciona" class="transition hover:text-[#123b45]">
            Cómo funciona
          </a>

          <a href="#soluciones" class="transition hover:text-[#123b45]">
            Soluciones
          </a>

          <a href="#seguridad" class="transition hover:text-[#123b45]">
            Seguridad
          </a>
        </nav>

        <a
          href="#project-check"
          class="rounded-lg bg-[#123b45] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0d3038]"
        >
          Calcula tu rentabilidad
        </a>

      </div>
    </header>


    <!-- HERO -->
    <main>
      <section class="relative overflow-hidden">
        <div class="mx-auto grid max-w-7xl gap-14 px-6 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-28">

          <!-- Mensaje principal -->
          <div class="flex flex-col justify-center">

            <div class="mb-6">
              <span class="inline-flex rounded-full border border-[#6aa69f]/30 bg-[#6aa69f]/10 px-4 py-2 text-sm font-semibold text-[#27665f]">
                Inteligencia operativa para proyectos profesionales
              </span>
            </div>

            <h1 class="max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight text-[#102f38] sm:text-6xl">
              Convierte información dispersa en
              <span class="text-[#2d7d73]">evidencia útil.</span>
            </h1>

            <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
              CLARISENDA transforma documentos, datos y conocimiento de proyecto
              en entregables estructurados, trazables y verificables.
            </p>

            <p class="mt-3 max-w-2xl text-lg leading-8 text-slate-600">
              Menos tiempo buscando, copiando y comprobando información.
              Más tiempo para decidir y aportar valor.
            </p>

            <div class="mt-9 flex flex-col gap-4 sm:flex-row">
              <a
                href="#project-check"
                class="rounded-lg bg-[#123b45] px-6 py-3.5 text-center font-semibold text-white shadow-sm transition hover:bg-[#0d3038]"
              >
                Calcula tu rentabilidad
              </a>

              <a
                href="#como-funciona"
                class="rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-center font-semibold text-slate-700 transition hover:border-slate-400"
              >
                Descubre cómo funciona
              </a>
            </div>

            <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 text-sm text-slate-500">
              <span>✓ Sin compromiso</span>
              <span>✓ Resultado inmediato</span>
              <span>✓ Sin registro inicial</span>
            </div>

          </div>


          <!-- Project Check -->
            <div class="flex items-center justify-center">
              <ProjectCheck />
            </div>

        </div>
      </section>
    </main>

  </div>
</Layout>
